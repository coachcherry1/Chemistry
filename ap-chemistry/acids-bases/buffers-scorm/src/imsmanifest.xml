<?xml version="1.0" encoding="UTF-8"?>
<manifest identifier="BUFFERS_MANIFEST" version="1.0"
          xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://www.imsproject.org/xsd/imscp_rootv1p1p2 imscp_rootv1p1p2.xsd
                              http://www.imsglobal.org/xsd/imsmd_rootv1p2p1 imsmd_rootv1p2p1.xsd
                              http://www.adlnet.org/xsd/adlcp_rootv1p2 adlcp_rootv1p2.xsd">

  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>

  <organizations default="BUFFERS_ORG">
    <organization identifier="BUFFERS_ORG">
      <title>Buffer Solution Visualization</title>
      <item identifier="BUFFERS_ITEM" identifierref="BUFFERS_RES" isvisible="true">
        <!-- No masteryscore: the SCO reports a 0-100 score and sets "completed"
             itself, so the LMS should not overwrite the status with passed/failed.
             Identifiers differ from every other package, so all can sit in one
             course. -->
        <title>Buffer Solution Visualization</title>
      </item>
    </organization>
  </organizations>

  <resources>
    <resource identifier="BUFFERS_RES" type="webcontent" adlcp:scormtype="sco" href="index.html">
      <file href="index.html"/>
      <file href="css/styles.css"/>
      <file href="js/util.js"/>
      <file href="js/buffer.js"/>
      <file href="js/flask.js"/>
      <file href="js/phcurve.js"/>
      <file href="js/picker.js"/>
      <file href="js/quiz.js"/>
      <file href="js/scorm.js"/>
      <file href="js/app.js"/>
      <file href="js/steps.js"/>
    </resource>
  </resources>

</manifest>
